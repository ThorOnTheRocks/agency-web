---
import Layout from '../layouts/Layout.astro';
import { FadeIn } from '../components/react/common/animations';
import { siteConfig } from '../config/site';
import { authorityPillars, fitStatements } from '../data/homepage';

export const prerender = true;

const authoritySignals = [
  'Enterprise logistics and payment-sensitive surfaces where reliability matters.',
  'Luxury commerce work where performance and presentation both shape trust.',
  'Independent product scopes where senior judgment has to carry from UI to deployment.',
];
---

<Layout title="Profile" fullBleed>
  <section class="border-b border-border/70">
    <div class="site-container py-14 md:py-20">
      <FadeIn client:visible>
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_320px] lg:items-end">
          <div>
            <p class="eyebrow">Profile</p>
            <h1 class="mt-4 section-title max-w-3xl">
              Senior product judgment for teams that need confidence quickly.
            </h1>
            <div class="mt-6 max-w-2xl space-y-4 body-copy">
              <p>
                I work across interface quality, frontend architecture, and delivery-critical product work.
                The value is not only in implementation. It is in making the product feel more credible,
                clarifying the decision that matters, and shipping it without unnecessary layers.
              </p>
              <p>
                My background spans enterprise platforms, payment-sensitive flows, and luxury commerce.
                That mix tends to be useful when a team needs both technical range and a sharper bar for what the product should feel like.
              </p>
            </div>
          </div>

          <div class="space-y-5">
            <div class="overflow-hidden rounded-[2rem] border border-border/70 bg-surface/88">
              <img
                src={siteConfig.assets.profilePortrait}
                alt="Gianluca Galota standing in front of a bookshelf"
                class="aspect-[4/5] w-full object-cover object-center"
                loading="eager"
              />
            </div>

            <div class="rounded-[1.75rem] border border-border/70 bg-surface/88 p-6 text-sm text-muted-foreground">
              <p class="eyebrow">Working style</p>
              <ul class="mt-4 space-y-3 leading-relaxed">
                <li>Remote from Spain, collaborating internationally.</li>
                <li>English, Spanish, Italian, and Portuguese.</li>
                <li>Direct communication, focused scopes, visible progress.</li>
                <li>Best with teams that want decisions made and shipped.</li>
              </ul>

              <div class="mt-8 flex flex-wrap gap-4">
                <a href={siteConfig.links.linkedin} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground">
                  LinkedIn
                </a>
                <a href={siteConfig.links.github} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground">
                  GitHub
                </a>
                <a href={`mailto:${siteConfig.author.email}`} class="transition-colors hover:text-foreground">
                  Email
                </a>
                <a href={siteConfig.links.resume} download class="transition-colors hover:text-foreground">
                  Download CV
                </a>
              </div>
            </div>
          </div>
        </div>
      </FadeIn>
    </div>
  </section>

  <section class="site-container py-14 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[280px_minmax(0,1fr)]">
      <FadeIn client:visible>
        <div>
          <p class="eyebrow">Why clients hire me</p>
          <h2 class="mt-4 section-title max-w-sm">The useful part is judgment as much as craft.</h2>
        </div>
      </FadeIn>

      <div class="grid gap-6 md:grid-cols-3">
        {authorityPillars.map((item, index) => (
          <FadeIn client:visible delay={index * 0.08}>
            <article class="rounded-[1.5rem] border border-border/70 bg-surface/88 p-6">
              <p class="eyebrow">{item.title}</p>
              <p class="mt-4 text-base leading-relaxed text-muted-foreground">{item.description}</p>
            </article>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-border/70 bg-muted/30">
    <div class="site-container py-14 md:py-20">
      <div class="grid gap-12 lg:grid-cols-[280px_minmax(0,1fr)]">
        <FadeIn client:visible>
          <div>
            <p class="eyebrow">Authority signals</p>
            <h2 class="mt-4 section-title max-w-sm">Experience that supports high-trust product work.</h2>
          </div>
        </FadeIn>

        <div class="divide-y divide-border/70 border-y border-border/70">
          {authoritySignals.map((item, index) => (
            <FadeIn client:visible delay={index * 0.08}>
              <article class="py-6">
                <p class="max-w-3xl text-base leading-relaxed text-foreground/86 md:text-lg">{item}</p>
              </article>
            </FadeIn>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="site-container py-14 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[280px_minmax(0,1fr)]">
      <FadeIn client:visible>
        <div>
          <p class="eyebrow">Best fit</p>
          <h2 class="mt-4 section-title max-w-sm">The kind of work where this model is most useful.</h2>
        </div>
      </FadeIn>

      <div class="grid gap-5">
        {fitStatements.map((item, index) => (
          <FadeIn client:visible delay={index * 0.08}>
            <article class="rounded-[1.4rem] border border-border/70 bg-surface/88 px-6 py-5">
              <p class="text-base leading-relaxed text-foreground/86">{item}</p>
            </article>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>
</Layout>
