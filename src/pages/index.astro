---
import Layout from '../layouts/Layout.astro';
import { bestFitStatements, engagementModes, processSteps } from '../data/homepage';
import { siteConfig } from '../config/site';
import { FadeIn } from '../components/react/common/animations';
import { getFeaturedProofProjects, type Project } from '../services/content';

const featuredProof: Project[] = await getFeaturedProofProjects();
const proofClients = featuredProof
  .map((project) => project.data.client)
  .filter(Boolean)
  .join(' · ');

export const prerender = true;
---

<Layout title={siteConfig.name} description={siteConfig.positioning.summary} fullBleed>
  <section class="relative isolate overflow-hidden border-b border-border/70">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--border))_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--border))_1px,transparent_1px)] bg-[size:56px_56px] opacity-[0.14]"></div>
      <div class="absolute inset-x-0 top-0 h-[32rem] bg-gradient-to-b from-accent/90 via-transparent to-transparent"></div>
      <div class="absolute right-[-8rem] top-12 h-[26rem] w-[26rem] rounded-full bg-primary/12 blur-3xl"></div>
      <div class="absolute left-[-8rem] bottom-[-8rem] h-[22rem] w-[22rem] rounded-full bg-foreground/7 blur-3xl"></div>
    </div>

    <div class="site-container relative grid min-h-[calc(100svh-4rem)] gap-10 py-12 md:py-16 lg:grid-cols-[minmax(0,1.04fr)_minmax(320px,34vw)] lg:items-center lg:gap-14">
      <FadeIn client:load>
        <div class="max-w-4xl self-center lg:self-end lg:pb-8">
          <p class="eyebrow">{siteConfig.positioning.label}</p>
          <h1 class="mt-4 max-w-3xl font-display text-[clamp(3.1rem,7vw,5.9rem)] leading-[0.92] tracking-[-0.07em] text-foreground">
            Direct solo product engineering for launch, redesign, and rescue work.
          </h1>
          <p class="mt-5 max-w-2xl text-balance text-lg leading-relaxed text-foreground/84 md:text-[1.3rem]">
            {siteConfig.positioning.soloModel}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={siteConfig.cta.primary.href}
              class="inline-flex min-h-11 items-center justify-center rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition-colors hover:bg-foreground/90"
            >
              {siteConfig.cta.primary.label}
            </a>
            <a
              href={siteConfig.cta.secondary.href}
              class="inline-flex min-h-11 items-center justify-center rounded-full border border-border/80 px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent"
            >
              {siteConfig.cta.secondary.label}
            </a>
          </div>

          <div class="mt-8 max-w-3xl border-t border-border/70 pt-5">
            <p class="eyebrow">Direct work</p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground md:text-base">
              {siteConfig.positioning.proofLine}
              {proofClients ? <span class="text-foreground"> Direct engagements shown below: {proofClients}.</span> : null}
            </p>
          </div>
        </div>
      </FadeIn>

      <FadeIn client:load delay={0.12}>
        <figure class="relative min-h-[24rem] overflow-hidden rounded-[2.8rem] border border-border/70 bg-surface/65 lg:min-h-[32rem]">
          <img
            src={siteConfig.assets.heroPortrait}
            alt="Gianluca Galota working at his desk"
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-foreground/82 via-foreground/18 to-transparent"></div>
          <figcaption class="absolute inset-x-4 bottom-4 rounded-[1.8rem] bg-foreground/82 px-5 py-5 text-primary-foreground shadow-[0_24px_60px_-32px_rgba(0,0,0,0.65)] backdrop-blur-sm">
            <p class="eyebrow text-white/70">Solo model</p>
            <p class="mt-4 max-w-lg text-base leading-relaxed text-white/92 md:text-lg">
              One senior operator, one working thread, direct collaboration from diagnosis through delivery.
            </p>
            <div class="mt-4 grid gap-3 text-sm leading-relaxed text-white/78 md:grid-cols-2">
              <p>Best for launches, redesigns, and rescue scopes where the product surface matters commercially.</p>
              <p>Remote from Spain, collaborating directly with international founders and product teams.</p>
            </div>
          </figcaption>
        </figure>
      </FadeIn>
    </div>
  </section>

  <section aria-labelledby="credibility-title" class="border-b border-border/70 bg-foreground text-primary-foreground">
    <div class="site-container py-12 md:py-14">
      <div class="grid gap-10 lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-16">
        <FadeIn client:visible>
          <div>
            <p class="eyebrow text-white/55">Credibility</p>
            <h2 id="credibility-title" class="mt-4 font-display text-[2.4rem] leading-[0.95] tracking-[-0.05em] text-white md:text-[3.2rem]">
              Direct work across three product environments where the surface could not feel average.
            </h2>
          </div>
        </FadeIn>

        <div class="grid gap-6 md:grid-cols-3">
          {featuredProof.map((project, index) => (
            <FadeIn client:visible delay={index * 0.08} className="h-full">
              <article class="h-full border-l border-white/12 pl-5">
                <p class="eyebrow text-white/50">{project.data.featuredLabel || project.data.sector || 'Selected proof'}</p>
                <h3 class="mt-4 text-sm uppercase tracking-[0.22em] text-white/58">{project.data.client}</h3>
                <p class="mt-4 font-display text-[1.9rem] leading-tight tracking-[-0.045em] text-white">
                  {project.data.featuredMetric || project.data.outcome}
                </p>
                {project.data.proofPoints?.[0] && (
                  <p class="mt-4 text-sm leading-relaxed text-white/74">{project.data.proofPoints[0]}</p>
                )}
              </article>
            </FadeIn>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="proof" class="scroll-mt-24">
    <div class="site-container py-20 md:py-28">
      <div class="max-w-3xl">
        <FadeIn client:visible>
          <p class="eyebrow">Selected proof</p>
          <h2 class="mt-4 section-title">Three direct engagements that show the standard of work.</h2>
          <p class="mt-5 max-w-2xl body-copy">
            Each case below answers a different buyer question: can the work protect a premium brand surface, stabilize a critical flow, and stay coherent under operational complexity?
          </p>
        </FadeIn>
      </div>

      <div class="mt-16 space-y-16 md:space-y-20">
        {featuredProof.map((project, index) => (
          <FadeIn client:visible delay={index * 0.08}>
            <article class:list={['grid gap-8 lg:grid-cols-[170px_minmax(0,1fr)] lg:gap-12', index > 0 && 'border-t border-border/70 pt-16 md:pt-20']}>
              <div class="lg:pt-3">
                <p class="font-display text-[3.4rem] leading-none tracking-[-0.07em] text-foreground/18 md:text-[4.8rem]">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <div class="mt-6 grid gap-4 text-sm leading-relaxed text-muted-foreground">
                  <div>
                    <p class="eyebrow">Role</p>
                    <p class="mt-2 text-foreground/86">{project.data.role}</p>
                  </div>
                  <div>
                    <p class="eyebrow">Timeframe</p>
                    <p class="mt-2 text-foreground/86">{project.data.timeframe}</p>
                  </div>
                  <div>
                    <p class="eyebrow">Scope</p>
                    <p class="mt-2 text-foreground/86">{project.data.scope}</p>
                  </div>
                </div>
              </div>

              <div>
                <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
                  <p class="eyebrow">{project.data.client}</p>
                  <span class="hidden h-1 w-1 rounded-full bg-border md:inline-flex"></span>
                  <p>{project.data.sector}</p>
                  {project.data.engagementType && (
                    <>
                      <span class="hidden h-1 w-1 rounded-full bg-border md:inline-flex"></span>
                      <p>{project.data.engagementType}</p>
                    </>
                  )}
                </div>
                <h3 class="mt-4 max-w-4xl font-display text-[2rem] leading-tight tracking-[-0.045em] text-foreground md:text-[3rem]">
                  {project.data.title}
                </h3>
                <p class="mt-5 max-w-3xl text-base leading-relaxed text-muted-foreground md:text-lg">
                  {project.data.description}
                </p>

                <div class="mt-8 grid gap-5 rounded-[2rem] border border-border/70 bg-surface/92 p-6 md:grid-cols-3 md:p-8">
                  <div>
                    <p class="eyebrow">Challenge</p>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground md:text-base">
                      {project.data.challenge}
                    </p>
                  </div>
                  <div>
                    <p class="eyebrow">Intervention</p>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground md:text-base">
                      {project.data.intervention}
                    </p>
                  </div>
                  <div>
                    <p class="eyebrow">Outcome</p>
                    <p class="mt-3 text-sm leading-relaxed text-foreground md:text-base">
                      {project.data.outcome}
                    </p>
                  </div>
                </div>

                <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px]">
                  {project.data.constraints?.length ? (
                    <div>
                      <p class="eyebrow">Constraints</p>
                      <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted-foreground md:text-base">
                        {project.data.constraints.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  ) : (
                    <div></div>
                  )}

                  {project.data.proofPoints?.length ? (
                    <aside class="border-t border-border/70 pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
                      <p class="eyebrow">Proof notes</p>
                      <ul class="mt-4 space-y-3 text-sm leading-relaxed text-foreground/86">
                        {project.data.proofPoints.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </aside>
                  ) : null}
                </div>
              </div>
            </article>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  <section id="services" class="border-y border-border/70 bg-muted/25 scroll-mt-24">
    <div class="site-container py-20 md:py-24">
      <FadeIn client:visible>
        <div class="max-w-3xl">
          <p class="eyebrow">Engagements</p>
          <h2 class="mt-4 section-title">Three ways this solo model is usually used.</h2>
          <p class="mt-5 max-w-2xl body-copy">
            The offer stays intentionally narrow: one senior operator, focused scopes, and product work where interface trust and delivery quality have to improve together.
          </p>
        </div>
      </FadeIn>

      <div class="mt-12 grid gap-px overflow-hidden rounded-[2.2rem] border border-border/70 bg-border/70 md:grid-cols-3">
        {engagementModes.map((mode, index) => (
          <FadeIn client:visible delay={index * 0.08} className="h-full">
            <article class="flex h-full flex-col bg-background/92 px-6 py-8 md:px-8 md:py-10">
              <p class="text-sm text-muted-foreground">{mode.timeline}</p>
              <h3 class="mt-6 font-display text-[2.2rem] leading-tight tracking-[-0.05em] text-foreground">
                {mode.title}
              </h3>
              <p class="mt-4 text-base leading-relaxed text-foreground/85">{mode.summary}</p>
              <div class="mt-8 border-t border-border/70 pt-4">
                <p class="eyebrow">Typical scope</p>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{mode.deliverables}</p>
              </div>
            </article>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  <section id="process" class="relative isolate overflow-hidden bg-foreground text-primary-foreground">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-y-0 right-[-10rem] w-[24rem] rounded-full bg-primary/18 blur-3xl"></div>
      <div class="absolute left-0 top-0 h-48 w-48 rounded-full bg-white/6 blur-3xl"></div>
    </div>

    <div class="site-container relative py-20 md:py-24">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
        <FadeIn client:visible>
          <div>
            <p class="eyebrow text-white/55">Working process</p>
            <h2 class="mt-4 max-w-2xl font-display text-[2.8rem] leading-[0.96] tracking-[-0.05em] text-white md:text-[4.1rem]">
              Structured enough to reduce risk, direct enough to keep momentum.
            </h2>
            <div class="mt-10 grid gap-6 md:grid-cols-3">
              {processSteps.map((step, index) => (
                <FadeIn client:visible delay={index * 0.08} className="h-full">
                  <article class="h-full border-t border-white/14 pt-6">
                    <p class="font-display text-[2.8rem] leading-none tracking-[-0.06em] text-primary/78">{step.number}</p>
                    <h3 class="mt-4 text-xl font-medium tracking-[-0.03em] text-white">{step.title}</h3>
                    <p class="mt-4 text-sm leading-relaxed text-white/72 md:text-base">{step.description}</p>
                  </article>
                </FadeIn>
              ))}
            </div>
          </div>
        </FadeIn>

        <FadeIn client:visible delay={0.16}>
          <aside class="rounded-[2rem] border border-white/12 bg-white/5 p-6 backdrop-blur-sm md:p-7">
            <p class="eyebrow text-white/55">Best when</p>
            <div class="mt-5 space-y-4 text-sm leading-relaxed text-white/76 md:text-base">
              {bestFitStatements.map((statement) => (
                <p>{statement}</p>
              ))}
            </div>
          </aside>
        </FadeIn>
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden border-t border-border/70 bg-primary text-primary-foreground">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-white/12 to-transparent"></div>
      <div class="absolute right-0 top-0 h-64 w-64 rounded-full bg-white/14 blur-3xl"></div>
      <div class="absolute bottom-[-6rem] left-[-4rem] h-56 w-56 rounded-full bg-foreground/10 blur-3xl"></div>
    </div>

    <div class="site-container relative py-20 md:py-24">
      <FadeIn client:visible>
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_260px] lg:items-end">
          <div>
            <p class="eyebrow text-white/60">Next step</p>
            <h2 class="mt-4 max-w-4xl font-display text-[2.8rem] leading-[0.96] tracking-[-0.05em] text-white md:text-[4.6rem]">
              If the product needs to look sharper and ship with less friction, start the brief.
            </h2>
            <p class="mt-5 max-w-2xl text-base leading-relaxed text-primary-foreground/88 md:text-lg">
              Share the context, the surface that matters, and the deadline. I will reply with fit, direction, and whether the scope should be treated as a launch, redesign, or rescue engagement.
            </p>
          </div>

          <div class="space-y-4 lg:pb-2">
            <a
              href={siteConfig.cta.primary.href}
              class="inline-flex min-h-11 w-full items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-white/92"
            >
              {siteConfig.cta.primary.label}
            </a>
            <a
              href={siteConfig.cta.secondary.href}
              class="inline-flex min-h-11 w-full items-center justify-center rounded-full border border-white/30 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-white/10"
            >
              {siteConfig.cta.secondary.label}
            </a>
          </div>
        </div>
      </FadeIn>
    </div>
  </section>
</Layout>
