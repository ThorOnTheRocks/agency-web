---
import Layout from '../layouts/Layout.astro';
import {
  authorityPillars,
  caseStudies,
  companies,
  engagementModes,
  processSteps,
  proofPoints,
} from '../data/homepage';
import { siteConfig } from '../config/site';
import { FadeIn } from '../components/react/common/animations';
import { ProjectImage } from '../components/react/common/ui';

const companyNames = companies.map(({ name }) => name).join(' · ');

export const prerender = true;
---

<Layout
  title={siteConfig.name}
  description="Premium product engineering for founders and product teams that need launch, redesign, or rescue work handled with senior judgment."
  fullBleed
>
  <section class="relative isolate overflow-hidden border-b border-border/70">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--border))_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--border))_1px,transparent_1px)] bg-[size:48px_48px] opacity-[0.16]"></div>
      <div class="absolute inset-x-0 top-0 h-[38rem] bg-gradient-to-b from-accent/70 via-transparent to-transparent"></div>
      <div class="absolute right-[-8rem] top-20 h-[26rem] w-[26rem] rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute left-[-10rem] bottom-[-10rem] h-[20rem] w-[20rem] rounded-full bg-foreground/6 blur-3xl"></div>
    </div>

    <div class="site-container relative flex min-h-[calc(100svh-4rem)] flex-col justify-end pb-12 pt-12 md:pb-16 md:pt-16">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1.15fr)_360px] lg:items-end">
        <FadeIn client:load>
          <div class="max-w-4xl">
            <p class="eyebrow">Premium product engineering for startup founders and product teams</p>
            <p class="mt-5 font-display text-[2rem] tracking-[-0.05em] text-foreground md:text-[2.7rem]">
              Gianluca Galota
            </p>
            <h1 class="mt-6 max-w-4xl font-display text-[clamp(3.7rem,9.2vw,7.8rem)] leading-[0.88] tracking-[-0.07em] text-foreground">
              Launch, redesign, or rescue the product before trust slips.
            </h1>
            <p class="mt-6 max-w-2xl text-balance text-lg leading-relaxed text-foreground/84 md:text-[1.45rem]">
              I help ambitious teams ship products that feel credible faster, convert with more confidence,
              and move from decision to delivery without agency overhead.
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href="/contact"
                class="inline-flex min-h-11 items-center justify-center rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition-colors hover:bg-foreground/90"
              >
                Start a project conversation
              </a>
              <a
                href="/#proof"
                class="inline-flex min-h-11 items-center justify-center rounded-full border border-border/80 px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent"
              >
                Review selected proof
              </a>
            </div>

            <p class="mt-8 max-w-3xl border-t border-border/70 pt-4 text-sm leading-relaxed text-muted-foreground">
              Trusted by <span class="text-foreground">{companyNames}</span>
            </p>
          </div>
        </FadeIn>

        <FadeIn client:load delay={0.12}>
          <div class="relative overflow-hidden rounded-[2rem] border border-border/70 bg-surface/88 p-4 shadow-[0_26px_80px_-52px_rgba(46,28,17,0.35)]">
            <div class="overflow-hidden rounded-[1.6rem] border border-border/70 bg-accent/50">
              <img
                src={siteConfig.assets.heroPortrait}
                alt="Gianluca Galota working at his desk"
                class="aspect-[5/6] w-full object-cover"
                loading="eager"
              />
            </div>

            <div class="relative px-3 pb-3 pt-6">
              <p class="eyebrow">Direct collaboration</p>
              <h2 class="mt-4 max-w-sm font-display text-[2rem] leading-tight tracking-[-0.04em] text-foreground">
                Senior product engineering without the agency layer.
              </h2>
              <div class="mt-6 grid gap-3 border-t border-border/70 pt-5 text-sm leading-relaxed text-muted-foreground md:text-base">
                <p>Remote from Spain, collaborating with international teams.</p>
                <p>Launch, redesign, and rescue scopes handled directly from product judgment through delivery.</p>
                <p>Best when clarity, pace, and interface trust need to improve at the same time.</p>
              </div>

              <div class="mt-6 flex flex-wrap gap-4 text-sm">
                <a href="/about" class="font-medium text-foreground transition-colors hover:text-primary">
                  View profile
                </a>
                <a
                  href={siteConfig.links.resume}
                  download
                  class="font-medium text-muted-foreground transition-colors hover:text-foreground"
                >
                  Download CV
                </a>
              </div>
            </div>
          </div>
        </FadeIn>
      </div>
    </div>
  </section>

  <section class="border-b border-border/70 bg-surface/70">
    <div class="site-container grid gap-8 py-10 md:grid-cols-3">
      {proofPoints.map((point, index) => (
        <FadeIn client:visible delay={index * 0.08}>
          <article class="border-l border-border/70 pl-5">
            <p class="font-display text-[2.6rem] tracking-[-0.05em] text-foreground">{point.value}</p>
            <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted-foreground">{point.label}</p>
          </article>
        </FadeIn>
      ))}
    </div>
  </section>

  <section id="proof" class="site-container scroll-mt-24 py-20 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[280px_minmax(0,1fr)]">
      <FadeIn client:visible>
        <div class="lg:sticky lg:top-24">
          <p class="eyebrow">Selected proof</p>
          <h2 class="mt-4 section-title max-w-sm">
            Client work presented as evidence, not an archive.
          </h2>
          <p class="mt-5 max-w-sm body-copy">
            These engagements are the clearest indicators of the kind of product work I am usually hired to handle:
            high-visibility launches, commercial redesigns, and release-sensitive rescue scopes.
          </p>
          <a
            href="/projects"
            class="mt-8 inline-flex text-sm font-medium text-foreground transition-colors hover:text-primary"
          >
            See the curated work page
          </a>
        </div>
      </FadeIn>

      <div class="space-y-8">
        {caseStudies.map((study, index) => (
          <FadeIn client:visible delay={index * 0.08}>
            <article class="group overflow-hidden rounded-[2rem] border border-border/70 bg-surface/88">
              <div class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_320px]">
                <div class="p-7 md:p-9">
                  <p class="eyebrow">{study.sector}</p>
                  <h3 class="mt-4 max-w-2xl font-display text-[2rem] leading-tight tracking-[-0.045em] text-foreground md:text-[2.5rem]">
                    {study.title}
                  </h3>
                  <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">
                    {study.challenge}
                  </p>

                  <div class="mt-8 grid gap-6 border-t border-border/70 pt-6 md:grid-cols-2">
                    <div>
                      <p class="eyebrow">Intervention</p>
                      <p class="mt-3 text-sm leading-relaxed text-foreground/82 md:text-base">
                        {study.intervention}
                      </p>
                    </div>
                    <div>
                      <p class="eyebrow">Outcome</p>
                      <p class="mt-3 text-sm leading-relaxed text-foreground md:text-base">
                        {study.outcome}
                      </p>
                    </div>
                  </div>
                </div>

                <div class="border-t border-border/70 p-6 lg:border-l lg:border-t-0">
                  <ProjectImage
                    alt={study.title}
                    placeholderLabel={study.placeholderLabel}
                    className="aspect-[4/5] rounded-[1.5rem]"
                  />
                  <div class="mt-5 border-t border-border/70 pt-4">
                    <p class="eyebrow">{study.company}</p>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{study.detail}</p>
                  </div>
                </div>
              </div>
            </article>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  <section id="services" class="border-y border-border/70 bg-muted/30 scroll-mt-24">
    <div class="site-container py-20 md:py-24">
      <FadeIn client:visible>
        <div class="max-w-3xl">
          <p class="eyebrow">Services</p>
          <h2 class="mt-4 section-title">Three ways teams usually bring me in.</h2>
          <p class="mt-5 max-w-2xl body-copy">
            The offer stays deliberately narrow: focused scopes, senior ownership, and a product standard that
            treats clarity and delivery quality as part of the same problem.
          </p>
        </div>
      </FadeIn>

      <div class="mt-12 divide-y divide-border/70 border-y border-border/70">
        {engagementModes.map((mode, index) => (
          <FadeIn client:visible delay={index * 0.08}>
            <article class="grid gap-5 py-8 md:grid-cols-[160px_minmax(0,1fr)_220px] md:items-start">
              <h3 class="font-display text-3xl tracking-[-0.04em] text-foreground">{mode.title}</h3>
              <div>
                <p class="text-base leading-relaxed text-foreground/85">{mode.summary}</p>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{mode.deliverables}</p>
              </div>
              <p class="text-sm text-muted-foreground md:text-right">{mode.timeline}</p>
            </article>
          </FadeIn>
        ))}
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {authorityPillars.map((item, index) => (
          <FadeIn client:visible delay={0.1 + index * 0.08}>
            <article class="rounded-[1.5rem] border border-border/70 bg-surface/85 p-6">
              <p class="eyebrow">{item.title}</p>
              <p class="mt-4 text-base leading-relaxed text-muted-foreground">{item.description}</p>
            </article>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  <section class="site-container py-20 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
      <FadeIn client:visible>
        <div>
          <p class="eyebrow">Working process</p>
          <h2 class="mt-4 section-title max-w-2xl">Structured enough to reduce risk, direct enough to keep momentum.</h2>
          <div class="mt-8 divide-y divide-border/70 border-y border-border/70">
            {processSteps.map((step, index) => (
              <FadeIn client:visible delay={index * 0.08}>
                <article class="grid gap-4 py-6 md:grid-cols-[120px_minmax(0,1fr)]">
                  <p class="text-sm text-muted-foreground">{step.number}</p>
                  <div>
                    <h3 class="text-xl font-medium tracking-[-0.03em] text-foreground">{step.title}</h3>
                    <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">
                      {step.description}
                    </p>
                  </div>
                </article>
              </FadeIn>
            ))}
          </div>
        </div>
      </FadeIn>

      <FadeIn client:visible delay={0.16}>
        <aside class="rounded-[2rem] border border-border/70 bg-accent/60 p-7">
          <p class="eyebrow">What to expect</p>
          <div class="mt-5 space-y-5 text-sm leading-relaxed text-muted-foreground md:text-base">
            <p>
              Most projects start with a concise project brief, a product link, and the main commercial or delivery risk.
            </p>
            <p>
              The strongest enquiries usually have a concrete deadline, a real decision-maker, and a product surface that matters.
            </p>
            <p>
              If the fit is right, I will reply with the next step rather than a long sales sequence.
            </p>
          </div>
        </aside>
      </FadeIn>
    </div>
  </section>

  <section class="border-t border-border/70">
    <div class="site-container py-20 md:py-24">
      <FadeIn client:visible>
        <div class="grid gap-10 rounded-[2.4rem] border border-border/70 bg-surface/92 p-8 md:p-12 lg:grid-cols-[minmax(0,1fr)_260px] lg:items-end">
          <div>
            <p class="eyebrow">Next project</p>
            <h2 class="mt-4 font-display text-[2.8rem] leading-[0.96] tracking-[-0.05em] text-foreground md:text-[4.4rem]">
              If the product needs to look sharper and ship with less friction, start here.
            </h2>
            <p class="mt-5 max-w-2xl body-copy">
              Share the context, current constraint, and timeline. I will respond with fit, the right next step,
              and whether the scope should be a launch, redesign, or rescue engagement.
            </p>
          </div>

          <div class="space-y-4">
            <a
              href="/contact"
              class="inline-flex min-h-11 w-full items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
            >
              Start the project brief
            </a>
            <a
              href="/about"
              class="inline-flex min-h-11 w-full items-center justify-center rounded-full border border-border/80 px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent"
            >
              Review profile and working style
            </a>
          </div>
        </div>
      </FadeIn>
    </div>
  </section>
</Layout>
