---
import Layout from '../layouts/Layout.astro';
import { FadeIn } from '../components/react/common/animations';
import { ContactForm } from '../components/react/ContactForm/ContactForm';
import { siteConfig } from '../config/site';

export const prerender = true;

const fitNotes = [
  'Launches that need to feel credible before they are fully mature.',
  'Redesigns where trust, clarity, or conversion have started to slip.',
  'Rescue work where weak UX or brittle delivery is slowing the team down.',
];
---

<Layout title="Contact" fullBleed>
  <section class="border-b border-border/70">
    <div class="site-container py-14 md:py-20">
      <FadeIn client:visible>
        <div class="grid gap-12 lg:grid-cols-[340px_minmax(0,1fr)]">
          <div>
            <p class="eyebrow">Contact</p>
            <h1 class="mt-4 section-title max-w-sm">Share the brief. I will reply with the right next step.</h1>
            <p class="mt-5 body-copy">
              This form is designed to qualify serious project work rather than maximize submissions.
              If the scope looks like a fit, I will come back with direction, availability, and how we should structure the conversation.
            </p>

            <div class="mt-8 rounded-[1.75rem] border border-border/70 bg-surface/88 p-6">
              <p class="eyebrow">Best fit</p>
              <ul class="mt-4 space-y-4 text-sm leading-relaxed text-muted-foreground md:text-base">
                {fitNotes.map((note) => (
                  <li class="border-t border-border/70 pt-4 first:border-t-0 first:pt-0">{note}</li>
                ))}
              </ul>
            </div>

            <div class="mt-8 space-y-4 border-t border-border/70 pt-6 text-sm text-muted-foreground">
              <div>
                <p class="eyebrow">Response</p>
                <p class="mt-2">Usually within 1-2 business days.</p>
              </div>
              <div>
                <p class="eyebrow">Direct email</p>
                <a href={`mailto:${siteConfig.author.email}`} class="mt-2 block text-foreground transition-colors hover:text-primary">
                  {siteConfig.author.email}
                </a>
              </div>
              <div>
                <p class="eyebrow">Links</p>
                <div class="mt-2 flex flex-wrap gap-4">
                  <a href={siteConfig.links.linkedin} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground">
                    LinkedIn
                  </a>
                  <a href={siteConfig.links.github} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground">
                    GitHub
                  </a>
                </div>
              </div>
              <p>Remote worldwide from Spain.</p>
            </div>
          </div>

          <ContactForm client:load />
        </div>
      </FadeIn>
    </div>
  </section>
</Layout>
