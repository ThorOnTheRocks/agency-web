---
import Layout from '../layouts/Layout.astro';
import { FadeIn } from '../components/react/common/animations';
import { ContactForm } from '../components/react/ContactForm/ContactForm';
import { siteConfig } from '../config/site';

export const prerender = true;

const fitNotes = [
  'Launches that need to feel credible before the product is fully mature.',
  'Redesigns where trust, clarity, or conversion have already started to slip.',
  'Rescue work where weak UX or brittle delivery is putting pressure on an important release.',
];
---

<Layout title="Start Project Brief" description="Start the project brief for launch, redesign, or rescue work." fullBleed>
  <section class="border-b border-border/70">
    <div class="site-container py-14 md:py-20">
      <FadeIn client:visible>
        <div class="grid gap-12 lg:grid-cols-[360px_minmax(0,1fr)]">
          <div>
            <p class="eyebrow">Project brief</p>
            <h1 class="mt-4 section-title max-w-sm">Start the brief. I will reply with fit and the next step.</h1>
            <p class="mt-5 body-copy">
              I work directly with a small number of clients at a time, so this form is designed to qualify serious scopes rather than maximize submissions.
            </p>

            <div class="mt-8 rounded-[1.9rem] border border-border/70 bg-surface/88 p-6">
              <p class="eyebrow">Best fit</p>
              <ul class="mt-4 space-y-4 text-sm leading-relaxed text-muted-foreground md:text-base">
                {fitNotes.map((note) => (
                  <li class="border-t border-border/70 pt-4 first:border-t-0 first:pt-0">{note}</li>
                ))}
              </ul>
            </div>

            <div class="mt-8 space-y-4 border-t border-border/70 pt-6 text-sm text-muted-foreground">
              <div>
                <p class="eyebrow">How I reply</p>
                <p class="mt-2">Usually within 1-2 business days, with fit, direction, and the right next step.</p>
              </div>
              <div>
                <p class="eyebrow">Direct email</p>
                <a href={`mailto:${siteConfig.author.email}`} class="mt-2 block text-foreground transition-colors hover:text-primary">
                  {siteConfig.author.email}
                </a>
              </div>
              <div>
                <p class="eyebrow">Profile</p>
                <a href={siteConfig.links.linkedin} target="_blank" rel="noopener noreferrer" class="mt-2 block transition-colors hover:text-foreground">
                  LinkedIn
                </a>
              </div>
              <p>Remote worldwide from Spain.</p>
            </div>
          </div>

          <ContactForm client:load />
        </div>
      </FadeIn>
    </div>
  </section>
</Layout>
