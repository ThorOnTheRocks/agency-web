---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title} fullBleed>
  <section class="border-b border-border/70">
    <div class="site-container py-14 md:py-20">
      <article class="mx-auto max-w-3xl">
        <header>
          <p class="eyebrow">Writing</p>
          <div class="mt-4 text-xs uppercase tracking-[0.18em] text-muted-foreground">
            {post.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </div>
          <h1 class="mt-4 font-display text-4xl leading-tight tracking-[-0.05em] md:text-5xl">
            {post.data.title}
          </h1>
          <div class="mt-6 h-px w-24 bg-border"></div>
        </header>
      </article>
    </div>
  </section>

  <section class="site-container py-14 md:py-20">
    <article class="mx-auto max-w-3xl">
      <div class="prose prose-neutral max-w-none prose-headings:font-display prose-headings:text-foreground prose-p:text-muted-foreground prose-a:text-primary prose-strong:text-foreground prose-li:text-muted-foreground hover:prose-a:text-primary/80 dark:prose-invert">
        <Content />
      </div>
    </article>
  </section>
</Layout>
