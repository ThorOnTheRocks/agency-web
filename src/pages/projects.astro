---
import Layout from '../layouts/Layout.astro';
import { FadeIn } from '../components/react/common/animations';
import { ProjectImage } from '../components/react/common/ui';
import { getAllProjects } from '../services/content';
import { caseStudies } from '../data/homepage';
import type { Project } from '../services/content';

export const prerender = true;

const projects: Project[] = await getAllProjects();
const independentProjects = projects.filter((project) => project.data.kind !== 'client');
---

<Layout
  title="Selected Work"
  description="Curated client proof and independent work across launches, redesigns, and rescue projects."
  fullBleed
>
  <section class="border-b border-border/70">
    <div class="site-container py-14 md:py-20">
      <FadeIn client:visible>
        <header class="max-w-3xl">
          <p class="eyebrow">Selected work</p>
          <h1 class="mt-4 section-title">
            Curated proof for buyers who need context, judgment, and outcomes.
          </h1>
          <p class="mt-5 max-w-2xl body-copy">
            This page separates client evidence from independent exploration. The point is not to browse a portfolio.
            It is to understand the kind of product problems I am trusted to solve and how I tend to approach them.
          </p>
        </header>
      </FadeIn>
    </div>
  </section>

  <section class="site-container py-14 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[260px_minmax(0,1fr)]">
      <FadeIn client:visible>
        <div class="lg:sticky lg:top-24">
          <p class="eyebrow">Client proof</p>
          <h2 class="mt-4 section-title max-w-sm">Selected engagements.</h2>
          <p class="mt-5 max-w-sm body-copy">
            Client work leads here because it is the clearest signal of how I handle commercial pressure,
            technical constraint, and product quality at the same time.
          </p>
        </div>
      </FadeIn>

      <div class="space-y-8">
        {caseStudies.map((study, index) => (
          <FadeIn client:visible delay={index * 0.08}>
            <article class="overflow-hidden rounded-[2rem] border border-border/70 bg-surface/88">
              <div class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_320px]">
                <div class="p-7 md:p-9">
                  <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
                    <p class="eyebrow">{study.company}</p>
                    <span class="hidden h-1 w-1 rounded-full bg-border md:inline-flex"></span>
                    <p>{study.sector}</p>
                  </div>
                  <h3 class="mt-4 max-w-2xl font-display text-[2rem] leading-tight tracking-[-0.045em] text-foreground md:text-[2.45rem]">
                    {study.title}
                  </h3>
                  <div class="mt-8 grid gap-6 border-t border-border/70 pt-6 md:grid-cols-3">
                    <div>
                      <p class="eyebrow">Challenge</p>
                      <p class="mt-3 text-sm leading-relaxed text-muted-foreground md:text-base">
                        {study.challenge}
                      </p>
                    </div>
                    <div>
                      <p class="eyebrow">Intervention</p>
                      <p class="mt-3 text-sm leading-relaxed text-muted-foreground md:text-base">
                        {study.intervention}
                      </p>
                    </div>
                    <div>
                      <p class="eyebrow">Outcome</p>
                      <p class="mt-3 text-sm leading-relaxed text-foreground md:text-base">
                        {study.outcome}
                      </p>
                    </div>
                  </div>
                </div>

                <div class="border-t border-border/70 p-6 lg:border-l lg:border-t-0">
                  <ProjectImage
                    alt={study.title}
                    placeholderLabel={study.placeholderLabel}
                    className="aspect-[4/5] rounded-[1.5rem]"
                  />
                  <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{study.detail}</p>
                </div>
              </div>
            </article>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-border/70 bg-muted/30">
    <div class="site-container py-14 md:py-20">
      <div class="grid gap-12 lg:grid-cols-[260px_minmax(0,1fr)]">
        <FadeIn client:visible>
          <div>
            <p class="eyebrow">Independent work</p>
            <h2 class="mt-4 section-title max-w-sm">Secondary signals, not the main sales story.</h2>
            <p class="mt-5 max-w-sm body-copy">
              Independent builds still matter because they show initiative and range. They sit here as supporting evidence, not as a substitute for client proof.
            </p>
          </div>
        </FadeIn>

        <div class="grid gap-6">
          {independentProjects.length > 0 ? independentProjects.map((project, index) => (
            <FadeIn client:visible delay={index * 0.08}>
              <article class="overflow-hidden rounded-[2rem] border border-border/70 bg-surface/88">
                <div class="grid gap-0 md:grid-cols-[280px_minmax(0,1fr)]">
                  <div class="p-6">
                    <ProjectImage
                      src={project.data.heroImage}
                      alt={project.data.title}
                      placeholderLabel="Independent build visual pending"
                      className="aspect-[4/5] rounded-[1.4rem]"
                    />
                  </div>
                  <div class="border-t border-border/70 p-7 md:border-l md:border-t-0">
                    <p class="eyebrow">{project.data.sector || 'Independent build'}</p>
                    <h3 class="mt-4 font-display text-[2rem] leading-tight tracking-[-0.045em] text-foreground">
                      {project.data.title}
                    </h3>
                    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
                      {project.data.description}
                    </p>

                    <div class="mt-8 grid gap-6 border-t border-border/70 pt-6 md:grid-cols-3">
                      <div>
                        <p class="eyebrow">Challenge</p>
                        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                          {project.data.challenge || 'Create a stronger personal platform for premium client acquisition.'}
                        </p>
                      </div>
                      <div>
                        <p class="eyebrow">Intervention</p>
                        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                          {project.data.intervention || 'Sharper content framing, cleaner hierarchy, and a more selective conversion path.'}
                        </p>
                      </div>
                      <div>
                        <p class="eyebrow">Outcome</p>
                        <p class="mt-3 text-sm leading-relaxed text-foreground">
                          {project.data.outcome || 'A more credible and commercially aligned digital presence.'}
                        </p>
                      </div>
                    </div>

                    <div class="mt-8 flex flex-wrap gap-3">
                      {project.data.link && (
                        <a
                          href={project.data.link}
                          target="_blank"
                          rel="noopener"
                          class="inline-flex min-h-11 items-center justify-center rounded-full border border-border/80 px-5 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent"
                        >
                          Visit live site
                        </a>
                      )}
                      {project.data.github && (
                        <a
                          href={project.data.github}
                          target="_blank"
                          rel="noopener"
                          class="inline-flex min-h-11 items-center justify-center rounded-full border border-border/80 px-5 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent"
                        >
                          Review source
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </article>
            </FadeIn>
          )) : (
            <FadeIn client:visible>
              <div class="rounded-[1.75rem] border border-dashed border-border/80 py-16 text-center">
                <p class="text-muted-foreground">Independent work will appear here as supporting proof.</p>
              </div>
            </FadeIn>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>
